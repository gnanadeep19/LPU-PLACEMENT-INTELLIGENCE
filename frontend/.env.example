# Copy to .env.local for local development.
# Only VITE_* values are exposed to the browser: never put secrets here.
VITE_API_PROXY_TARGET=http://127.0.0.1:5000

# Optional transition mode. These are public browser values; never use a secret key.
# VITE_AUTH_PROVIDER=supabase
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Optional absolute API base. The default "/api" is proxied by Vite in
# development and by Nginx in the production container.
# VITE_API_BASE_URL=/api

# Privacy-safe telemetry (https only). When unset, events stay in memory.
# VITE_TELEMETRY_ENDPOINT=https://telemetry.example.edu/v1/events

# Controlled pilot aid; keep disabled for institutional use.
# VITE_PILOT_FEEDBACK=on

# Build identifier reported in telemetry (no user data).
# VITE_BUILD_ID=local
