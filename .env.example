APP_ENV=development
HOST=0.0.0.0
PORT=5000
FLASK_DEBUG=false
MODEL_PATH=backend/placement_model.joblib
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
HISTORY_DATABASE_PATH=backend/data/assessment_history.sqlite3
AUTH_DATABASE_PATH=backend/data/auth.sqlite3
SESSION_TTL_SECONDS=28800
AUTH_COOKIE_SECURE=false
COHORT_MIN_GROUP_SIZE=5
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=300
MAX_CONTENT_LENGTH=65536
VITE_API_PROXY_TARGET=http://127.0.0.1:5000

# Optional transition mode. Keep local until the migration guide is completed.
# Never put a secret/service-role key in these variables.
# AUTH_PROVIDER=supabase
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Experimental: requires Supabase authentication and the reviewed coaching RPC migration.
# Existing SQLite coaching records are NOT automatically copied or synchronized.
# COACHING_STORE=supabase
